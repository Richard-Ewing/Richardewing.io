graph TD
    classDef os fill:#1A1A1A,stroke:#333,stroke-width:3px,color:#fff,font-family:monospace;
    classDef yaml fill:#6366f1,stroke:#4338ca,stroke-width:2px,color:#fff;
    classDef fail fill:#f43f5e,stroke:#e11d48,stroke-width:2px,color:#fff;
    classDef pass fill:#10b981,stroke:#059669,stroke-width:2px,color:#fff;

    P[Agent Payload Proposal] --> OS{Deterministic OS Admissibility Gate}:::os
    
    subgraph POLICY EVALUATION
        OS --> Y1[(Tool Permissions YAML)]:::yaml
        OS --> Y2[(Financial Budgets YAML)]:::yaml
        OS --> Y3[(Architectural Boundaries YAML)]:::yaml
        OS --> Y4[(Execution Safety YAML)]:::yaml
    end
    
    Y1 --> E1{Valid?}
    Y2 --> E2{Valid?}
    Y3 --> E3{Valid?}
    Y4 --> E4{Valid?}
    
    E1 -- No --> H[Governance Halt: Payload Destroyed]:::fail
    E2 -- No --> H
    E3 -- No --> H
    E4 -- No --> H
    
    E1 -- Yes --> C
    E2 -- Yes --> C
    E3 -- Yes --> C
    E4 -- Yes --> C
    
    C{Execution Certainty Engine}:::os
    C -->|Dry Run Fails| H
    C -->|Dry Run Passes| A[Payload Admitted for Execution]:::pass
