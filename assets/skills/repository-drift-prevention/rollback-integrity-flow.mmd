graph TD
    classDef governance fill:#1A1A1A,stroke:#333,stroke-width:2px,color:#fff,font-family:monospace;
    classDef agent fill:#0ea5e9,stroke:#0284c7,stroke-width:2px,color:#fff;
    classDef fs fill:#8b5cf6,stroke:#6d28d9,stroke-width:2px,color:#fff;
    classDef fail fill:#f43f5e,stroke:#e11d48,stroke-width:2px,color:#fff;
    classDef pass fill:#10b981,stroke:#059669,stroke-width:2px,color:#fff;

    A[Agent Attempts File Write]:::agent --> V{Repository Validator}:::governance
    
    subgraph ARCHITECTURAL GATING
        V --> V1{Is Protected File?}
        V --> V2{Banned Extension?}
        V --> V3{Outside Scope Directory?}
    end

    V1 -- Yes --> H[Governance Halt: Write Blocked]:::fail
    V2 -- Yes --> H
    V3 -- Yes --> H

    V1 -- No --> V2
    V2 -- No --> V3
    V3 -- No --> W[Write to File System]:::fs

    W --> C[Agent Requests Merge]:::agent
    
    C --> D{Repo Divergence Detector}:::governance
    
    D -->|Check Diff| D1{Modified package.json?}
    D1 -- Yes --> B[Pre-Commit Hook Rejected]:::fail
    D1 -- No --> M[Merge Approved]:::pass
