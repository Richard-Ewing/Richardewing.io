graph TD
    classDef governance fill:#1A1A1A,stroke:#333,stroke-width:2px,color:#fff,font-family:monospace;
    classDef agent fill:#0ea5e9,stroke:#0284c7,stroke-width:2px,color:#fff;
    classDef cab fill:#e11d48,stroke:#be123c,stroke-width:2px,color:#fff;
    classDef fail fill:#f43f5e,stroke:#e11d48,stroke-width:2px,color:#fff;
    classDef pass fill:#10b981,stroke:#059669,stroke-width:2px,color:#fff;

    A[Agent Attempts Infrastructure Mutation]:::agent --> R{Mutation Risk Detector}:::governance
    
    R -->|Scan Payload| R1{High Risk?}
    R -->|Scan Payload| R2{Medium Risk?}
    
    R1 -- Yes --> C{Change Approval Engine}:::governance
    R2 -- Yes --> C
    
    R1 -- No --> R2
    R2 -- No --> E[Auto-Approve Execution]:::pass
    
    C -->|Halt Container| P[Ping Authority via Exogram API]:::cab
    
    P --> H{Human Authority Review}:::cab
    
    H -- Reject --> X[Governance Halt: Mutation Denied]:::fail
    H -- Approve --> S[Sign Cryptographic Token]:::pass
    
    S --> E
