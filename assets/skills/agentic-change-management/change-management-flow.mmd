graph TD
    classDef danger fill:#FEF2F2,stroke:#EF4444,stroke-width:2px,color:#991B1B;
    classDef success fill:#F0FDF4,stroke:#22C55E,stroke-width:2px,color:#166534;
    classDef neutral fill:#FFFFFF,stroke:#E5E7EB,stroke-width:2px,color:#111827;
    classDef governance fill:#F0F9FF,stroke:#0EA5E9,stroke-width:2px,color:#0369A1;

    A[Agent Proposes Mutation] ::: neutral --> B{Mutation Risk Detector} ::: governance
    
    B -->|Calculates Blast Radius| C{Change Approval Engine} ::: governance
    
    C -->|LOW Risk Tier| D[Autonomous Execution] ::: success
    
    C -->|HIGH Risk Tier| E[Route to Pull Request] ::: neutral
    E --> F[Human Peer Review] ::: governance
    
    C -->|CRITICAL Risk Tier| G[Halt Execution & Pause Session] ::: danger
    G --> H[Route to SRE/Executive] ::: governance
    H --> I{Cryptographic Sign-off?} ::: neutral
    
    I -->|Approved| J[Inject Override Token] ::: success
    J --> D
    
    I -->|Rejected| K[Session Terminated & Rolled Back] ::: danger
