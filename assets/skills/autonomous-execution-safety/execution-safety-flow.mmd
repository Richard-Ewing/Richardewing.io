graph TD
    classDef governance fill:#1A1A1A,stroke:#333,stroke-width:2px,color:#fff,font-family:monospace;
    classDef agent fill:#0ea5e9,stroke:#0284c7,stroke-width:2px,color:#fff;
    classDef host fill:#8b5cf6,stroke:#6d28d9,stroke-width:2px,color:#fff;
    classDef fail fill:#f43f5e,stroke:#e11d48,stroke-width:2px,color:#fff;
    classDef pass fill:#10b981,stroke:#059669,stroke-width:2px,color:#fff;

    A[Agent Generates Shell Command]:::agent --> V{Runtime Permission Validator}:::governance
    
    subgraph ZERO-TRUST EXECUTION GATING
        V --> V1{Regex Denylist?}
        V --> V2{Exact Denylist?}
        V --> V3{Base Cmd Whitelist?}
        V --> B{Autonomous Boundary Engine}:::governance
        B --> B1{CWD Traversal Check}
    end

    V1 -- Yes --> H[Governance Halt]:::fail
    V2 -- Yes --> H
    V3 -- No --> H
    B1 -- Fail --> H

    V1 -- No --> V2
    V2 -- No --> V3
    V3 -- Yes --> B
    B1 -- Pass --> E[Execute on Host OS]:::host

    H --> S{Is Command Sev-1? (e.g. rm -rf)}
    S -- Yes --> Q[Escalation Halt System: Quarantine Container & Revoke API Keys]:::fail
    S -- No --> R[Return Error to Agent Context]:::agent
