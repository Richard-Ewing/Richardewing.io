graph TD
    classDef danger fill:#FEF2F2,stroke:#EF4444,stroke-width:2px,color:#991B1B;
    classDef success fill:#F0FDF4,stroke:#22C55E,stroke-width:2px,color:#166534;
    classDef neutral fill:#FFFFFF,stroke:#E5E7EB,stroke-width:2px,color:#111827;
    classDef governance fill:#F0F9FF,stroke:#0EA5E9,stroke-width:2px,color:#0369A1;

    A[Agent Proposes Shell Command] ::: neutral --> B{Runtime Permission Validator} ::: governance
    
    B -->|Check Forbidden Tokens| C{Contains 'rm -rf' / 'sudo'?} ::: neutral
    C -->|Yes| D[Halt: Destructive Intent Detected] ::: danger
    
    C -->|No| E{Check Allowed Prefixes} ::: neutral
    E -->|Prefix Not Whitelisted| F[Halt: Default Deny Policy] ::: danger
    
    E -->|Prefix Whitelisted| G{Check Command Chaining} ::: neutral
    G -->|Contains '&&' or '; '| H[Halt: Injection Attempt] ::: danger
    
    G -->|Clean Command| I[Pass to Autonomous Boundary Engine] ::: success
    I --> J[OS Execution] ::: success
    
    D & F & H --> K[Escalation Halt System] ::: governance
    K --> L[Sever Shell Access] ::: danger
