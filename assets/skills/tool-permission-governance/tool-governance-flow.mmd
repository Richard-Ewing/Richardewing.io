graph TD
    classDef governance fill:#1A1A1A,stroke:#333,stroke-width:2px,color:#fff,font-family:monospace;
    classDef orchestrator fill:#6366f1,stroke:#4338ca,stroke-width:2px,color:#fff;
    classDef agent fill:#0ea5e9,stroke:#0284c7,stroke-width:2px,color:#fff;
    classDef llm fill:#8b5cf6,stroke:#6d28d9,stroke-width:2px,color:#fff;
    classDef fail fill:#f43f5e,stroke:#e11d48,stroke-width:2px,color:#fff;
    classDef pass fill:#10b981,stroke:#059669,stroke-width:2px,color:#fff;

    O[Master Orchestrator]:::orchestrator -->|Spawns Agent| S{Tool Scope Engine}:::governance
    
    S -->|Fetch Policy| P[(permission-boundary-policy.yaml)]
    S -->|Inject Allowed Tools| LLM[LLM Context Window]:::llm
    
    LLM -->|Generates Tool Call| A[Agent Attempt]:::agent
    
    A --> C{Capability Validator}:::governance
    
    subgraph CRYPTOGRAPHIC EXECUTION GATE
        C --> C1{Globally Restricted?}
        C --> C2{In Role Allowlist?}
        C --> C3{In Role Denylist?}
    end
    
    C1 -- Yes --> H[Governance Halt: Security Breach]:::fail
    C2 -- No --> H
    C3 -- Yes --> H
    
    C1 -- No --> C2
    C2 -- Yes --> C3
    C3 -- No --> E[Execute Tool]:::pass
