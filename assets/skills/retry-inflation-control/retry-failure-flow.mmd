graph TD
    classDef governance fill:#1A1A1A,stroke:#333,stroke-width:2px,color:#fff,font-family:monospace;
    classDef agent fill:#0ea5e9,stroke:#0284c7,stroke-width:2px,color:#fff;
    classDef test fill:#8b5cf6,stroke:#6d28d9,stroke-width:2px,color:#fff;
    classDef fail fill:#f43f5e,stroke:#e11d48,stroke-width:2px,color:#fff;
    classDef pass fill:#10b981,stroke:#059669,stroke-width:2px,color:#fff;

    A[Agent Generates Code]:::agent --> T{Test Execution}:::test
    T -- Pass --> S[Proceed]:::pass
    T -- Fail --> E[Extract stderr]

    E --> G{Retry Burn Engine}:::governance
    
    subgraph FINANCIAL & COMPUTE BREAKERS
        G --> C1{USD > $2.50?}
        G --> C2{Retries > 10?}
        G --> C3{Same Error x 3?}
        G --> C4{Semantic Loop?}
    end

    C1 -- Yes --> H[Financial Halt]:::fail
    C2 -- Yes --> H2[Compute Halt]:::fail
    C3 -- Yes --> H3[Infinite Loop Halt]:::fail
    C4 -- Yes --> H4[Thrashing Halt]:::fail

    C1 -- No --> C2
    C2 -- No --> C3
    C3 -- No --> C4
    C4 -- No --> R[Permit Retry]:::pass

    R --> A
