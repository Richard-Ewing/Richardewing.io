graph TD
    classDef danger fill:#FEF2F2,stroke:#EF4444,stroke-width:2px,color:#991B1B;
    classDef success fill:#F0FDF4,stroke:#22C55E,stroke-width:2px,color:#166534;
    classDef neutral fill:#FFFFFF,stroke:#E5E7EB,stroke-width:2px,color:#111827;
    classDef governance fill:#F0F9FF,stroke:#0EA5E9,stroke-width:2px,color:#0369A1;

    A[Agent Generates Code] ::: neutral --> B[Token Burn Logged] ::: governance
    
    B --> C{Retry Burn Engine} ::: governance
    C -->|Session Cost > Budget| D[Halt: Economic Breach] ::: danger
    
    C -->|Session Cost < Budget| E{Code Execution} ::: neutral
    
    E -->|Success| F[Task Complete] ::: success
    
    E -->|Failure| G{Recursive Loop Detector} ::: governance
    
    G -->|Identical Patch Detected| H[Inject Pattern Interrupt] ::: governance
    H --> A
    
    G -->|New Patch Proposed| A
    
    D --> I[Cost Containment Playbook] ::: governance
