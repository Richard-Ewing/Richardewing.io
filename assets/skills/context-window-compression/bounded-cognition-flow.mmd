graph TD
    classDef governance fill:#1A1A1A,stroke:#333,stroke-width:2px,color:#fff,font-family:monospace;
    classDef llm fill:#8b5cf6,stroke:#6d28d9,stroke-width:2px,color:#fff;
    classDef memory fill:#0ea5e9,stroke:#0284c7,stroke-width:2px,color:#fff;
    classDef warning fill:#f59e0b,stroke:#d97706,stroke-width:2px,color:#fff;
    classDef pass fill:#10b981,stroke:#059669,stroke-width:2px,color:#fff;

    M[(Raw Agent History)]:::memory --> C{Context Compression Engine}:::governance
    
    C -->|Tier 1: System| T1[Preserve 100%]
    C -->|Tier 2: Recent| T2[Preserve Last N Turns]
    C -->|Tier 3: Tools| T3[Truncate Large Payloads]
    C -->|Tier 4: Stale| T4[Evict]

    T1 --> B[Assemble Bounded Payload]
    T2 --> B
    T3 --> B
    
    B --> E{Payload > 16k Tokens?}
    E -- Yes --> W[Warning: Token Ceiling Breached]:::warning
    W --> CR[Trigger Checkpoint Rotation]:::governance
    
    E -- No --> P[Send to API]:::pass
    P --> LLM[LLM Inference]:::llm
    
    CR -->|Wipe Ephemeral State| S[Inject Deterministic Save State]:::memory
    S --> P
