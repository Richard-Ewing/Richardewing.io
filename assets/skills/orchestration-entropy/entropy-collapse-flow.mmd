graph TD
    classDef danger fill:#FEF2F2,stroke:#EF4444,stroke-width:2px,color:#991B1B;
    classDef success fill:#F0FDF4,stroke:#22C55E,stroke-width:2px,color:#166534;
    classDef neutral fill:#FFFFFF,stroke:#E5E7EB,stroke-width:2px,color:#111827;
    classDef governance fill:#F0F9FF,stroke:#0EA5E9,stroke-width:2px,color:#0369A1;

    A[Agent A Initiates Handoff] ::: neutral --> B{Orchestrator Governor} ::: governance
    
    B -->|Check Chain Depth| C{Depth > 5?} ::: neutral
    C -->|Yes| D[Halt: Recursion Spiral] ::: danger
    
    C -->|No| E{Agent Chain Validator} ::: governance
    E -->|Check Payload Variance| F{Drift > 0.15?} ::: neutral
    
    F -->|Yes| G[Halt: Semantic Drift] ::: danger
    
    F -->|No| H[Save Workflow Checkpoint] ::: governance
    H --> I[Execute Agent B] ::: success
    
    D --> J[Orchestration Reset Playbook] ::: governance
    G --> J
