graph TD
    classDef governance fill:#1A1A1A,stroke:#333,stroke-width:2px,color:#fff,font-family:monospace;
    classDef system fill:#0ea5e9,stroke:#0284c7,stroke-width:2px,color:#fff;
    classDef llm fill:#8b5cf6,stroke:#6d28d9,stroke-width:2px,color:#fff;
    classDef fail fill:#f43f5e,stroke:#e11d48,stroke-width:2px,color:#fff;
    classDef pass fill:#10b981,stroke:#059669,stroke-width:2px,color:#fff;

    U[User Invokes AI Feature]:::system --> M{Margin Threshold Validator}:::governance
    
    M -->|Margin Negative| D[Degrade to Cheap Model or Deny]:::fail
    M -->|Margin Positive| C{Cost Containment Engine}:::governance

    C -->|Calculate Max Call Cost| C1{Cost > $0.15?}
    
    C1 -- Yes --> H[Financial Halt: Context Too Large]:::fail
    C1 -- No --> L[Execute LLM API Call]:::llm

    L --> R[Record Actual Token Spend]:::system
    R --> S[Update Tenant Ledger]:::system
