graph TD
    classDef danger fill:#FEF2F2,stroke:#EF4444,stroke-width:2px,color:#991B1B;
    classDef success fill:#F0FDF4,stroke:#22C55E,stroke-width:2px,color:#166534;
    classDef neutral fill:#FFFFFF,stroke:#E5E7EB,stroke-width:2px,color:#111827;
    classDef governance fill:#F0F9FF,stroke:#0EA5E9,stroke-width:2px,color:#0369A1;

    A[Task Manifest Created] ::: neutral --> B{Margin Threshold Validator} ::: governance
    
    B -->|Inference Est > Max ROI| C[Halt: Negative Feature Margin] ::: danger
    
    B -->|Inference Est < Max ROI| D[Agent Session Starts] ::: success
    
    D --> E[LLM Inference Turn] ::: neutral
    
    E --> F{Cost Containment Engine} ::: governance
    
    F -->|Calculate Token USD Burn| G{Total Spend > Budget Ceiling?} ::: neutral
    
    G -->|Yes| H[Halt: Economic Circuit Breaker Tripped] ::: danger
    H --> I[Sever API Connection] ::: danger
    
    G -->|No| J[Continue Execution] ::: success
    J --> E
