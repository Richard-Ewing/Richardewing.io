graph TD
    classDef governance fill:#1A1A1A,stroke:#333,stroke-width:2px,color:#fff,font-family:monospace;
    classDef agent fill:#0ea5e9,stroke:#0284c7,stroke-width:2px,color:#fff;
    classDef human fill:#e11d48,stroke:#be123c,stroke-width:2px,color:#fff;
    classDef pass fill:#10b981,stroke:#059669,stroke-width:2px,color:#fff;
    classDef fail fill:#f43f5e,stroke:#e11d48,stroke-width:2px,color:#fff;

    A[Autonomous Agent Generation]:::agent --> B{Admissibility Middleware}
    
    subgraph ZERO-TRUST GATING LAYER
        B --> C{Diff > 400 Lines?}
        B --> D{Coverage < 85%?}
        B --> E{Scope Drift?}
    end

    C -- Yes --> R[Reject & Retry]:::fail
    D -- Yes --> R
    E -- Yes --> R

    R --> F{Retries > 3?}
    F -- No --> A
    F -- Yes --> G[Governance Halt: Trigger Escalation]:::governance

    C -- No --> V[Payload Verified]:::pass
    D -- No --> V
    E -- No --> V

    V --> H{Escalation Matrix}
    H -- Low Risk --> I[Auto-Merge]
    H -- Medium Risk --> J[Ping Code Owner]:::human
    H -- High Risk --> K[Ping Staff Architect]:::human
