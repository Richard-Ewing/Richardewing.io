{
  "qa-verifier": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/post-edit-qa-hook.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "turn-end-deploy-guard": {
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/stop-hook.mjs",
        "timeout": 15
      }
    ]
  }
}
