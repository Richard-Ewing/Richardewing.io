{
  "qa-verifier": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/scripts/verify-qa.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "turn-end-deploy-guard": {
    "Stop": [
      {
        "type": "command",
        "command": "node .agents/scripts/stop-hook.mjs",
        "timeout": 15
      }
    ]
  }
}