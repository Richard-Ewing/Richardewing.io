{
  "qa-verifier": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const fs=require('fs');const p=fs.existsSync('scripts/verify-qa.mjs')?'scripts/verify-qa.mjs':'.agents/scripts/verify-qa.mjs';require('child_process').execSync('node '+p,{stdio:'inherit'});\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "turn-end-deploy-guard": {
    "Stop": [
      {
        "type": "command",
        "command": "node -e \"const fs=require('fs');const p=fs.existsSync('scripts/stop-hook.mjs')?'scripts/stop-hook.mjs':'.agents/scripts/stop-hook.mjs';require('child_process').spawnSync(process.execPath,[p],{stdio:'inherit'});\"",
        "timeout": 15
      }
    ]
  }
}
