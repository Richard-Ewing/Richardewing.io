{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "richardewing-io",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_ADSENSE_CLIENT_ID": "ca-pub-9421469136745918"
  },
  "routes": [
    { "pattern": "richardewing.io/*", "zone_name": "richardewing.io" },
    { "pattern": "www.richardewing.io/*", "zone_name": "richardewing.io" }
  ]
}
